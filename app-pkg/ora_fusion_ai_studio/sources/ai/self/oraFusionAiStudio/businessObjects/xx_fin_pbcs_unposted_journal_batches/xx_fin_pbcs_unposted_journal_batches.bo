    "tools": [
      {
        "name": "getall_journalBatches",
        "description": "Get a page of journal batches from all periods where UserJeSourceName equals PBCS and Status is not P (Posted). Read only. Follow hasMore using offset and limit.",
        "operationId": "getall_journalBatches",
        "operationType": "GET",
        "resourcePath": "/fscmRestApi/resources/11.13.18.05/journalBatches?q=UserJeSourceName%3D%27PBCS%27%20and%20Status%21%3D%27P%27&onlyData=true&orderBy=JeBatchId:asc&limit={limit}&offset={offset}&fields=JeBatchId,BatchName,DefaultPeriodName,Status,StatusMeaning,UserJeSourceName,ApprovalStatusMeaning,CompletionStatusMeaning,ErrorMessage,RunningTotalAccountedDr,RunningTotalAccountedCr,PostedDate",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "limit",
            "dataType": "integer",
            "description": "Maximum batches per page; use 100 for this workflow.",
            "id": 2,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": "100"
          },
          {
            "name": "offset",
            "dataType": "integer",
            "description": "Zero-based page offset, initially 0; advance by the returned page count.",
            "id": 3,
            "isToken": true,
            "location": "query",
            "source": "placeholder",
            "defaultValue": "0"
          }
        ],
        "headers": {
