        {
          "id": "1788957787196",
          "code": "NEW_MULTI_AGENT_NODE",
          "type": "MULTI_AGENT",
          "metadata": {
            "name": "New multi_agent Node",
            "maxInteractions": 10
          },
          "diagram": {
            "x": 5332,
