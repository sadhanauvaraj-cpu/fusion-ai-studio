          "code": "FETCH_ALL_BATCH_PAGES",
          "type": "WHILE",
          "metadata": {
            "name": "Fetch All Batch Pages",
            "dataPipeline": {
              "rootNode": "start_6",
              "pipelineNodes": [
                {
                  "id": "start_6",
