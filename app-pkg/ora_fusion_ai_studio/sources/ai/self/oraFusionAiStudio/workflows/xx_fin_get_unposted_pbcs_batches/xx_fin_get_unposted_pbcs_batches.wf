                  "code": "FETCH_PBCS_BATCH_PAGE",
                  "type": "BO_FUNCTION",
                  "metadata": {
                    "name": "Fetch PBCS Batch Page",
                    "businessObjectCode": "XX_FIN_PBCS_UNPOSTED_JOURNAL_BATCHES",
                    "functionName": "getall_journalBatches"
                  },
                  "outcomes": {
                    "success": "4"
                  },
                  "inputs": [
                    {
                      "id": "3_limit",
                      "name": "limit",
                      "type": "integer",
                      "value": 100
                    },
                    {
                      "id": "3_offset",
                      "name": "offset",
                      "type": "string",
                      "value": "{{$context.$variables.batchState.offset}}"
                    }
                  ],
                  "diagram": {
                    "x": 4995,
                    "y": 5249.5
                  },
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\"\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
                },
                {
                  "id": "4",
                  "code": "COLLECT_BATCH_PAGE",
                  "type": "CODE",
                  "metadata": {
                    "name": "Collect Batch Page",
                    "returnType": "object",
                    "sourceCode": "const page = $context.$nodes.FETCH_PBCS_BATCH_PAGE.$output; const state = $context.$variables.batchState; if (!page || !Array.isArray(page.items) || typeof page.hasMore !== 'boolean') { throw new Error('Journal batch service returned an invalid page.'); } if (page.offset !== state.offset) { throw new Error('Journal batch service returned an unexpected page offset.'); } if (page.hasMore && page.items.length === 0) { throw new Error('Journal batch service reported more results without advancing pagination.'); } return {offset: state.offset + page.items.length, hasMore: page.hasMore, items: state.items.concat(page.items), pages: state.pages + 1};"
                  },
                  "outcomes": {
                    "success": "5"
                  },
                  "inputs": [],
                  "diagram": {
                    "x": 5385,
                    "y": 5072.5
                  },
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "id": "5",
                  "code": "ADVANCE_BATCH_PAGE",
                  "type": "SET_FIELDS",
                  "metadata": {
                    "name": "Advance Batch Page"
                  },
                  "outcomes": {
                    "success": "end_6"
                  },
                  "inputs": [
                    {
                      "id": "5_batchState",
                      "name": "batchState",
                      "value": "{{$context.$nodes.COLLECT_BATCH_PAGE.$output.result}}"
                    }
                  ],
                  "diagram": {
                    "x": 5835,
                    "y": 5072.5
                  }
                },
                {
                  "id": "end_6",
                  "code": "END_BATCH_PAGES",
                  "type": "END",
                  "metadata": {
                    "name": "End Batch Page"
                  },
                  "inputs": [],
                  "outcomes": {}
                }
              ]
            }
          },
          "outcomes": {
            "success": "7"
          },
          "inputs": [
            {
              "id": "6_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$variables.batchState.hasMore}}"
            }
          ],
          "diagram": {
            "x": 4764,
            "y": 4957,
            "width": 1391,
            "height": 384.5
          }
        },
        {
          "id": "7",
          "code": "RETURN_JOURNAL_BATCHES",
          "type": "CODE",
          "metadata": {
            "name": "Return Journal Batches",
            "returnType": "object",
            "sourceCode": "const state = $context.$variables.batchState; return {sourceName: 'PBCS', postingStatusFilter: 'Not Posted', count: state.items.length, items: state.items, pagesFetched: state.pages, hasMore: false, message: state.items.length ? 'Retrieved non-posted PBCS journal batches across all accounting periods.' : 'No non-posted PBCS journal batches were found.'};"
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [],
          "diagram": {
            "x": 7647,
            "y": 5108
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
